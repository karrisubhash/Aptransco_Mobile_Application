# Local-only environment for the transcoapps backend.
# Read by _load_local_env() at the top of transcoapps/settings.py, so it
# applies however the server is started. Never commit this file.

# --- checkCred gateway (the active login mechanism) ------------------------
# App-level HTTP Basic Auth for https://qaserv.aptransco.co.in/qath.
# These are the GATEWAY's own credentials - distinct from any employee's
# id/password. Until both are filled in, every login fails early with
# "APTRANSCO_AUTH_USER / APTRANSCO_AUTH_PASS are not configured."
# and the employee password is never checked.
APTRANSCO_AUTH_USER=
APTRANSCO_AUTH_PASS=
# APTRANSCO_AUTH_URL=https://qaserv.aptransco.co.in/qath

# --- Local dev login (TEMPORARY - remove once the gateway pair above works) -
# Bypasses checkCred entirely and resolves the employee id against the local
# EmployeeCadreSnapshot table. Does NOT verify anyone's real password - it
# checks the shared value below. Only works while DEBUG=True.
# Set LINE_INSPECTION_DEV_LOGIN=0 (or delete these lines) to restore real auth.
LINE_INSPECTION_DEV_LOGIN=1
# NOTE: this is a shared dev secret, not a real password check. ANY employee id
# present in EmployeeCadreSnapshot signs in with this one string. It is set to
# the real employee password only so the login screen feels normal while
# testing - it proves nothing about who is signing in.
LINE_INSPECTION_DEV_PASSWORD=Admin@123

# --- Extra ALLOWED_HOSTS ----------------------------------------------------
# This laptop's Wi-Fi IP, so a phone on the same network can reach
# `runserver 0.0.0.0:8000`. Update if the network changes.
EXTRA_ALLOWED_HOSTS=10.100.109.250

# --- PostgreSQL ------------------------------------------------------------
# settings.py already defaults to these values and connects fine locally.
# Uncomment only to override.
# PG_NAME=aptransco_ai_db
# PG_USER=postgres
# PG_PASSWORD=
# PG_HOST=localhost
# PG_PORT=5432
